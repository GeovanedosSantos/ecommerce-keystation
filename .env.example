POSTGRES_USER=usuario_exemplo
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=nome_banco_exemplo
POSTGRES_PORT=5432

# Conexão usada pelo Prisma e pelo app
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Atenção: usuário, senha,banco e porta devem ser iguais às variáveis de cima

DATABASE_URL="postgresql://usuario_exemplo:troque_esta_senha@127.0.0.1:5432/nome_banco_exemplo"
# Chave que assina o cookie de sessão. Gere uma com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque_por_uma_chave_aleatoria_de_64_caracteres_hex"